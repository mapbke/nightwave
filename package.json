{
  "name": "silence",
  "version": "0.1.0",
  "private": false,
  "description": "silence. — private offline thoughts journal",
  "author": "Nightwave",
  "main": "electron/silence-main.cjs",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder --win portable",
    "build:win": "electron-builder --win portable"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.mapbke.silence",
    "productName": "silence.",
    "files": [
      "electron/silence-main.cjs",
      "electron/silence-preload.cjs",
      "silence/**/*",
      "package.json"
    ],
    "asar": true,
    "compression": "store",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "silence.exe"
    }
  }
}
